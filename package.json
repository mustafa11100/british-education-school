/* الملاحظات */
app.get("/api/notes", (req, res) => {
  const notes = db.prepare(`
    SELECT
      notes.id,
      notes.student_id,
      notes.text,
      notes.created_at,
      students.name AS student_name
    FROM notes
    LEFT JOIN students
      ON students.id = notes.student_id
    ORDER BY notes.id DESC
  `).all();

  res.json(notes);
});

app.post("/api/notes", (req, res) => {
  const {
    student_id,
    text
  } = req.body;

  if (!student_id || !text) {
    return res.status(400).json({
      error: "اختر الطالب واكتب الملاحظة"
    });
  }

  const result = db.prepare(`
    INSERT INTO notes
    (student_id, text, created_at)
    VALUES (?, ?, ?)
  `).run(
    student_id,
    text,
    new Date().toISOString()
  );

  res.json({
    success: true,
    id: result.lastInsertRowid
  });
});

